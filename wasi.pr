type Fdflags `public `doc("File descriptor flags.") {
    int _bits `value;

    get append Fdflags `public `global => Fdflags(_bits: 1);
    get dsync Fdflags `public `global => Fdflags(_bits: 2);
    get nonblock Fdflags `public `global => Fdflags(_bits: 4);
    get rsync Fdflags `public `global => Fdflags(_bits: 8);
    get sync Fdflags `public `global => Fdflags(_bits: 16);

    has(this, Fdflags flag) bool `public `doc("Check if a flag is set.") {
        return (this._bits & flag._bits) != 0;
    }

    set(this, Fdflags flag) Fdflags `public `doc("Return a copy with the given flag set.") {
        return Fdflags(_bits: this._bits | flag._bits);
    }
}

